# Copy to .env and adjust. Vite only exposes variables that start with VITE_.

# Base address of the FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# How long to wait for an API response before showing an error, in milliseconds
VITE_API_TIMEOUT_MS=10000
# How money is shown: ISO 4217 currency code and a BCP 47 locale
VITE_CURRENCY=USD
VITE_LOCALE=en-US
