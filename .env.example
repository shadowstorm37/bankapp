PORT=8000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=bankapp
MONGO_DB_NAME=bankapp
# React dev servers allowed to call the API (Vite: 5173, Create React App: 3000)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Login tokens (JWT). Generate a secret with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<long-random-string>
JWT_EXPIRE_MINUTES=60

# Admin account created on startup if it doesn't exist.
# Development values: use a strong password anywhere else.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@bank.local
